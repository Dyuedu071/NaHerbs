# Copy this file to .env at the repository root.
SERVER_PORT=8080
DB_NAME=naherb
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/naherb
DB_USERNAME=postgres
DB_PASSWORD=change-me
JPA_DDL_AUTO=update

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_TIMEOUT=2s

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=naherb-api
JWT_ACCESS_EXPIRATION=PT15M
REFRESH_TOKEN_EXPIRATION=P7D
ACCESS_COOKIE_NAME=NAHERB_ACCESS_TOKEN
REFRESH_COOKIE_NAME=NAHERB_REFRESH_TOKEN
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173

VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:8080
