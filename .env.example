# Copy this file to .env at the repository root.
SERVER_PORT=8080
DB_NAME=naherb
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/naherb
# Supabase pooler example:
# DB_URL=jdbc:postgresql://<host>:6543/postgres?prepareThreshold=0&sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=change-me
JPA_DDL_AUTO=update

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_TIMEOUT=2s

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=naherb-api
JWT_ACCESS_EXPIRATION=PT15M
REFRESH_TOKEN_EXPIRATION=P7D
ACCESS_COOKIE_NAME=NAHERB_ACCESS_TOKEN
REFRESH_COOKIE_NAME=NAHERB_REFRESH_TOKEN
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI / Chatbot (OpenAI)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_KNOWLEDGE_PATH=../content/chatbot-knowledge
CHATBOT_INGEST_ON_STARTUP=true
RAG_TOP_K=14
RAG_PER_DOCUMENT_TOP_K=6

# Uploads (avatar, media)
UPLOAD_BASE_PATH=uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/api
UPLOAD_MAX_AVATAR_BYTES=2097152

VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:8080
