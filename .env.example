# Copy this file to .env at the repository root.
DOCKER_USERNAME=your-dockerhub-username
SERVER_PORT=8080
DB_PORT=6543
# Supabase pooler example:
DB_URL=jdbc:postgresql://<host>:6543/postgres?prepareThreshold=0&sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=change-me
JPA_DDL_AUTO=update

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_TIMEOUT=2s

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=naherb-api
JWT_ACCESS_EXPIRATION=PT15M
REFRESH_TOKEN_EXPIRATION=P7D
ACCESS_COOKIE_NAME=NAHERB_ACCESS_TOKEN
REFRESH_COOKIE_NAME=NAHERB_REFRESH_TOKEN
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://naherb.com.vn,https://www.naherb.com.vn,https://api.naherb.com.vn

# AI / Chatbot (OpenAI)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_KNOWLEDGE_PATH=/data/chatbot-knowledge
CHATBOT_INGEST_ON_STARTUP=true
RAG_TOP_K=14
RAG_PER_DOCUMENT_TOP_K=6

# Uploads (avatar, media)
UPLOAD_BASE_PATH=uploads
UPLOAD_PUBLIC_BASE_URL=https://api.naherb.com.vn/api
UPLOAD_MAX_AVATAR_BYTES=2097152

NEXT_PUBLIC_API_BASE_URL=https://api.naherb.com.vn/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_TINYMCE_API_KEY=
NEXT_PUBLIC_SITE_URL=https://naherb.com.vn
